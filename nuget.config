<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Fuentes de paquetes explícitas y NADA heredado de la máquina: `clear` borra lo que
    venga de la configuración de usuario. Así el `restore` de un portátil y el de un
    runner traen lo mismo, que es media reproducibilidad.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value="%NUGET_PACKAGES%" />
  </config>

</configuration>
