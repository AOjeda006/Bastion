<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Fuentes de paquetes explícitas y NADA heredado de la máquina: `clear` borra lo que
    venga de la configuración de usuario. Así el `restore` de un portátil y el de un
    runner traen lo mismo, que es media reproducibilidad.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    NO se fija `globalPackagesFolder`, y es deliberado. NuGet expande variables con sintaxis
    `%VAR%`; si la variable NO está definida no falla: toma el literal y lo resuelve RELATIVO
    a este fichero, es decir, dentro del repositorio. Eso rompió la CI (ver
    `docs/adr/adr-0002-cache-de-paquetes-y-post-step-de-la-ci.md`).

    El valor por omisión (`~/.nuget/packages`) es justo el que se quiere: compartido entre
    proyectos y en el sitio donde `actions/setup-dotnet` espera cachear. La reproducibilidad
    la dan las fuentes explícitas con `<clear/>`, el `packageSourceMapping` y los
    `packages.lock.json` — nunca la ubicación de la caché.
  -->

</configuration>
