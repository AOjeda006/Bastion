# syntax=docker/dockerfile:1
#
# Frontal de Bastion (`bastion-web`) — build multi-stage, servido por nginx no-root.
# Contexto de construcción: la RAÍZ del repositorio.
#   docker build -f deploy/Dockerfile.web -t bastion-web .

# ---------------------------------------------------------------- compilación
FROM node:22.22-alpine AS build
WORKDIR /origen

# El lockfile primero: `npm ci` solo se rehace si cambian las dependencias.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------- ejecución
# La variante `-unprivileged` corre como uid 101 y escucha en 8080: no hace falta
# ni root ni capacidades para puertos bajos.
FROM nginxinc/nginx-unprivileged:1.29-alpine AS final

COPY --from=build /origen/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-cabeceras-de-seguridad.conf /etc/nginx/cabeceras-de-seguridad.conf

# Los mapas de fuentes NO se sirven. Se generan (`sourcemap: 'hidden'`) porque hacen falta para
# leer una traza, y se quedan en el artefacto que publica la CI; aquí se borran, porque publicar el
# mapa es publicar el código. Se hace con `find` y no con `rm assets/*.map` para que el día que un
# mapa salga de otra carpeta siga desapareciendo.
USER root
RUN find /usr/share/nginx/html -name '*.map' -delete
USER 101

EXPOSE 8080

# La sonda apunta al bucle IPv4 EXPLÍCITO: `localhost` resuelve también a ::1, el wget de
# BusyBox toma la primera dirección que le den, y `listen 8080` de nginx es solo IPv4.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/bin/sh", "-c", "wget -qO- http://127.0.0.1:8080/ > /dev/null || exit 1"]
