# syntax=docker/dockerfile:1
#
# API de Bastion — build multi-stage, usuario no-root, base mínima.
# Contexto de construcción: la RAÍZ del repositorio.
#   docker build -f deploy/Dockerfile.api -t bastion-api .
#

# ---------------------------------------------------------------- compilación
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /origen

# Primero SOLO lo que define las dependencias: así un cambio de código no invalida
# la capa de `restore`, que es la cara (`herramientas/docker.md`, orden de capas).
COPY Directory.Build.props Directory.Packages.props nuget.config* ./
COPY Bastion.sln ./
COPY src/ ./src/
# `tests/` entero, no solo su Directory.Build.props: la solución referencia proyectos de
# test, y `dotnet restore Bastion.sln` falla si no encuentra sus .csproj. Restaurar la
# solución COMPLETA, y no solo el proyecto de la API, es deliberado: así la imagen resuelve
# exactamente el mismo grafo de paquetes que la CI, y no pueden divergir en silencio.
COPY tests/ ./tests/

RUN dotnet restore Bastion.sln

COPY . .
RUN dotnet publish src/Api/Bastion.Api.csproj \
        --configuration "$BUILD_CONFIGURATION" \
        --no-restore \
        --output /publicado \
        /p:UseAppHost=false

# ---------------------------------------------------------------- ejecución
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS final
WORKDIR /app

# Las imágenes de .NET son MÍNIMAS: no traen wget, ni curl, ni ningún otro cliente HTTP.
# Sin uno, ni el HEALTHCHECK de abajo ni el de docker-compose pueden ejecutarse, y el
# contenedor se queda en `starting` para siempre — que es un fallo mudo, no un error.
# `curl` es lo más pequeño que lo resuelve. Se instala como root y se vuelve a `app`.
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Usuario sin privilegios. La imagen de .NET ya trae el uid 1654 como `app`.
USER app

# Globalización COMPLETA: Bastion formatea en es-ES y ordena con acentos y 'ñ'.
# Ponerlo en invariante rompe eso en silencio (ver Directory.Build.props).
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

COPY --from=build --chown=app:app /publicado .

EXPOSE 8080

# Sonda en la propia imagen, no solo en compose: comprueba que el proceso RESPONDE,
# no que el contenedor siga vivo.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["/bin/sh", "-c", "curl --fail --silent http://127.0.0.1:8080/health/live || exit 1"]

ENTRYPOINT ["dotnet", "Bastion.Api.dll"]
