# Copia este fichero a `deploy/.env` y rellena los valores. `deploy/.env` está en
# .gitignore y NO se commitea nunca.
#
# Aviso de `herramientas/docker.md`: este fichero lo leen dos herramientas con dos
# gramáticas distintas. No lo cargues con `set -a; . deploy/.env` — eso no es "leer
# variables", es ejecutar código escrito para otra herramienta. Un espacio, un `$` o
# una almohadilla cambian lo que hace.

# ---------- PostgreSQL ----------
POSTGRES_DB=bastion_dev
POSTGRES_USER=bastion
# Cámbiala. Vale cualquier cosa en local, pero que no sea la del ejemplo.
POSTGRES_PASSWORD=cambia esta contrasena
POSTGRES_PORT=5432

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
JWT_ISSUER=https://localhost
JWT_AUDIENCE=bastion-web
# Clave de firma de los JWT. Genera una propia, p. ej.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=genera una clave con openssl rand -base64 48

# ---------- Semilla de arranque ----------
# La primera empresa y la primera cuenta. Solo se aplican si NO hay ningun usuario dado
# de alta, asi que despues del primer arranque se pueden retirar (y conviene hacerlo: la
# contrasena deja de hacer falta en cuanto se ha entrado una vez y se ha cambiado).
#
# Si falta cualquiera de las siete, la semilla no se aplica y lo dice en el registro: el
# sistema arranca cerrado, que es el estado seguro. Requiere el esquema ya migrado.
BASTION_SEMILLA_ADMIN_CORREO=
BASTION_SEMILLA_ADMIN_CONTRASENA=
BASTION_SEMILLA_EMPRESA_NIF=
BASTION_SEMILLA_EMPRESA_RAZON_SOCIAL=
BASTION_SEMILLA_EMPRESA_CALLE=
BASTION_SEMILLA_EMPRESA_CODIGO_POSTAL=
BASTION_SEMILLA_EMPRESA_POBLACION=
# ISO 3166-1 alfa-2. Por omision, ES.
BASTION_SEMILLA_EMPRESA_PAIS=ES

# ---------- Frontal ----------
WEB_PORT=5173

# ---------- Observabilidad ----------
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686
