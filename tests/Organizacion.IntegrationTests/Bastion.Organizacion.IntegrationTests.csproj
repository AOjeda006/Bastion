<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de integración del módulo Organización (§13): contra PostgreSQL DE VERDAD, levantado
    con Testcontainers. Nada de EF Core InMemory, que no traduce SQL real, ignora restricciones
    y columnas computadas, y da falsos verdes.

    Solo PERSISTENCIA. Lo que se prueba por HTTP se fue a tests/Api.IntegrationTests en el ítem
    0.5: una petición autenticada necesita a Identidad, y traerse el host aquí habría metido el
    otro módulo en el contenedor de este —y con él un segundo historial de migraciones que
    rompería EsquemaDelModuloTests, que cuenta exactamente uno—.

    Todo lo de aquí lleva `[Trait("Category", "Integracion")]`: es lo que separa la batería
    rápida (sin Docker) de la completa en `AGENTS.md` y en los dos pasos de la CI.
  -->

  <ItemGroup Label="Sujeto de prueba">
    <ProjectReference Include="../../src/Modules/Organizacion/Bastion.Organizacion.Infrastructure/Bastion.Organizacion.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Marco de pruebas">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
