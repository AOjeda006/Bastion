<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de integración del módulo Organización (§13): contra PostgreSQL DE VERDAD, levantado
    con Testcontainers. Nada de EF Core InMemory, que no traduce SQL real, ignora restricciones
    y columnas computadas, y da falsos verdes.

    Todo lo de aquí lleva `[Trait("Category", "Integracion")]`: es lo que separa la batería
    rápida (sin Docker) de la completa en `AGENTS.md` y en los dos pasos de la CI.
  -->

  <ItemGroup Label="Sujeto de prueba">
    <ProjectReference Include="../../src/Modules/Organizacion/Bastion.Organizacion.Infrastructure/Bastion.Organizacion.Infrastructure.csproj" />
    <!--
      Y el host, para probar los endpoints del módulo COMO LOS VE UN CLIENTE: por HTTP, con el
      contenedor de dependencias real y contra la misma base de datos de verdad. Un test que
      llamara al caso de uso directamente no comprobaría ni el enlace de modelo, ni el 400 por
      campo que genera [ApiController], ni el 201 con su Location, que es donde vive la mitad
      del contrato.

      No van en Api.FunctionalTests porque aquel proyecto es, a propósito, el de lo que se puede
      comprobar SIN dependencias externas (ver su csproj). Esto necesita PostgreSQL.
    -->
    <ProjectReference Include="../../src/Api/Bastion.Api.csproj" />
  </ItemGroup>

  <ItemGroup Label="Marco de pruebas">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
