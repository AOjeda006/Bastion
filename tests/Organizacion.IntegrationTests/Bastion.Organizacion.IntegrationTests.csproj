<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de integración del módulo Organización (§13): contra PostgreSQL DE VERDAD, levantado
    con Testcontainers. Nada de EF Core InMemory, que no traduce SQL real, ignora restricciones
    y columnas computadas, y da falsos verdes.

    Solo PERSISTENCIA. Lo que se prueba por HTTP se fue a tests/Api.IntegrationTests en el ítem
    0.5: una petición autenticada necesita a Identidad, y traerse el host aquí habría metido el
    otro módulo en el contenedor de este —y con él un segundo historial de migraciones que
    rompería EsquemaDelModuloTests, que cuenta exactamente uno—.

    Todo lo de aquí lleva `[Trait("Category", "Integracion")]` MENOS una excepción declarada, del
    ítem 1.3: `LaTraduccionASqlTests` genera el SQL de los listados sin ejecutarlo, y para eso
    hace falta el proveedor de Npgsql y el modelo, no un servidor. Es la parte del carril que no
    necesita el carril, y por tanto la que tiene que poder ejercerse con Docker parado; vive aquí
    porque este es el único proyecto que ve los repositorios (`InternalsVisibleTo`, abajo). Si
    algún día necesita una fila, deja de ser esa excepción y le toca el rasgo.
  -->

  <ItemGroup Label="Sujeto de prueba">
    <ProjectReference Include="../../src/Modules/Organizacion/Bastion.Organizacion.Infrastructure/Bastion.Organizacion.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Marco de pruebas">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Label="Censo de reglas">
    <!--
      El descubrimiento del censo, compartido y enlazado desde `tests/Comun`. La clase que lo usa
      vive en ESTE ensamblado —la reflexion solo alcanza al suyo— pero la consulta que descubre los
      casos es una sola: copiada, el dia que una version cuente los `[Theory]` y otra no, el carril
      que se quedo atras deja de censar justo lo que dejo de contar.
    -->
    <Compile Include="../Comun/CensoDeReglas.cs" Link="Comun/CensoDeReglas.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
