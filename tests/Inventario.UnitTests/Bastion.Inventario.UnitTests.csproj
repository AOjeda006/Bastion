    <ProjectReference Include="../../src/BuildingBlocks/Domain/Bastion.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Inventario/Bastion.Inventario.Domain/Bastion.Inventario.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Inventario/Bastion.Inventario.Contracts/Bastion.Inventario.Contracts.csproj" />
    <ProjectReference Include="../../src/Modules/Inventario/Bastion.Inventario.Application/Bastion.Inventario.Application.csproj" />
  </ItemGroup>

