<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests funcionales del host (§13 del plan maestro). WebApplicationFactory levanta la API
    EN MEMORIA con su Program.cs real y su contenedor de dependencias real: no hay doble del
    host, se prueba el contrato que ve un cliente HTTP.

    Aquí SOLO entra lo que se puede comprobar sin dependencias externas. Lo que necesita
    PostgreSQL de verdad va con Testcontainers y la etiqueta `Category=Integracion`, que la
    CI ejecuta en un paso aparte.
  -->

  <ItemGroup Label="Sujeto de prueba">
    <ProjectReference Include="../../src/Api/Bastion.Api.csproj" />
  </ItemGroup>

  <ItemGroup Label="Marco de pruebas">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Label="Captura del registro">
    <!--
      Serilog explicito y no por transitividad de la API: estos tests usan ILogEventSink y
      CompactJsonFormatter directamente, y un paquete que se usa se declara. Los dos son
      Apache-2.0.
    -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup Label="Censo de reglas">
    <!--
      El descubrimiento del censo, compartido y enlazado desde `tests/Comun`. La clase que lo usa
      vive en ESTE ensamblado —la reflexion solo alcanza al suyo— pero la consulta que descubre los
      casos es una sola: copiada, el dia que una version cuente los `[Theory]` y otra no, el carril
      que se quedo atras deja de censar justo lo que dejo de contar.
    -->
    <Compile Include="../Comun/CensoDeReglas.cs" Link="Comun/CensoDeReglas.cs" />
    <Compile Include="../Comun/RaizDelRepositorio.cs" Link="Comun/RaizDelRepositorio.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
