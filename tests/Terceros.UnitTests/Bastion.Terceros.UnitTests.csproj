<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests unitarios del módulo Terceros (§13: dominio puro, sin infraestructura y sin E/S).

    Referencia al dominio del módulo, a su contrato, y al dominio común: `Nif` vive en
    `BuildingBlocks.Domain` y es quien valida el carácter de control, así que la batería
    generada de este proyecto lo necesita compilado. Ningún doble, ninguna base de datos.

    Lo que NO se puede probar aquí, y por eso hay tests de integración: que el alta contra un
    tercero bloqueado conteste lo MISMO que el alta contra uno que ya existe. Esa es una
    propiedad de dos respuestas HTTP puestas una al lado de la otra, y aquí no hay respuestas.
  -->

  <ItemGroup Label="Sujeto de prueba">
    <ProjectReference Include="../../src/BuildingBlocks/Domain/Bastion.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Terceros/Bastion.Terceros.Domain/Bastion.Terceros.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Terceros/Bastion.Terceros.Contracts/Bastion.Terceros.Contracts.csproj" />

    <!--
      REFERENCIA A `Application` DESDE EL ÍTEM 1.10, por el mismo motivo por el que Catálogo la
      tiene desde el 1.8: lo que hay que probar del cruce mutuo vive en la capa de aplicación y no
      puede vivir en otra. `EstadoDeLaTarifa` es un contrato de CATÁLOGO, y el `Domain` de este
      módulo no lo ve a propósito —el agregado recibe un `Guid?` ya comprobado—; así que la
      traducción de los tres estados a sus desenlaces no es un invariante de `Tercero`.

      Y es aritmética de ramas, que es lo que el ítem 1.7 enseñó a no dejar solo detrás de
      Testcontainers: con Docker parado, un `switch` con una rama mal puesta saldría verde.

      Arrastra `Catalogo.Contracts` por transitividad, y eso NO es un cruce nuevo: es el mismo que
      `Bastion.Terceros.Application` ya declara, visto desde el proyecto que lo prueba.
    -->
    <ProjectReference Include="../../src/Modules/Terceros/Bastion.Terceros.Application/Bastion.Terceros.Application.csproj" />
  </ItemGroup>

  <ItemGroup Label="Marco de pruebas">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
