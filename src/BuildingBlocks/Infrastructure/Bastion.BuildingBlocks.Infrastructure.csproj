<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infraestructura común (§12): base de EF Core, outbox, auditoría, filtro multiempresa,
    ProblemDetails e idempotencia. Es el único de los tres bloques comunes que conoce la
    base de datos; los otros dos no saben que existe.
  -->

  <ItemGroup>
    <ProjectReference Include="../Application/Bastion.BuildingBlocks.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Solo las ABSTRACCIONES de las sondas: aquí se implementa `IHealthCheck`, pero quién
      las publica como endpoints HTTP es el host. Este proyecto no conoce ASP.NET Core.
    -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
