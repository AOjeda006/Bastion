<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Host único de ASP.NET Core y composition root de la solución (§4 del plan maestro).

    Es el ÚNICO proyecto autorizado a ver la Infrastructure de los módulos: el cableado
    de dependencias ocurre aquí y solo aquí, separado del uso
    (`principios/clean-architecture.md`). Un módulo nunca se registra a sí mismo por su
    cuenta ni alcanza la infraestructura de otro.

    Referencia dos capas de cada módulo, y por motivos distintos:
      - Endpoints       -> para que el host descubra sus controladores.
      - Infrastructure  -> para registrar su DbContext y sus adaptadores en el contenedor.
    Application y Domain llegan por transitividad; Contracts es lo único que un módulo
    puede ver de OTRO módulo.

    Solo están los módulos de la fase 0. Los de las fases 1-11 tienen su carpeta creada y
    vacía: cada fase añade los suyos al empezar (ver docs/PLAN.md).
  -->

  <ItemGroup Label="Bloques comunes">
    <ProjectReference Include="../BuildingBlocks/Infrastructure/Bastion.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Módulos de la fase 0">
    <ProjectReference Include="../Modules/Identidad/Bastion.Identidad.Endpoints/Bastion.Identidad.Endpoints.csproj" />
    <ProjectReference Include="../Modules/Identidad/Bastion.Identidad.Infrastructure/Bastion.Identidad.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Organizacion/Bastion.Organizacion.Endpoints/Bastion.Organizacion.Endpoints.csproj" />
    <ProjectReference Include="../Modules/Organizacion/Bastion.Organizacion.Infrastructure/Bastion.Organizacion.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Auditoria/Bastion.Auditoria.Endpoints/Bastion.Auditoria.Endpoints.csproj" />
    <ProjectReference Include="../Modules/Auditoria/Bastion.Auditoria.Infrastructure/Bastion.Auditoria.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Observabilidad y datos">
    <!--
      Cablear la telemetría y el origen de datos es CONSTRUCCIÓN del sistema, y por eso
      vive en el composition root. Los componentes que se cablean (la comprobación de
      PostgreSQL, por ejemplo) viven en BuildingBlocks.Infrastructure.
    -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <!--
      Program.cs son sentencias de nivel superior, así que el compilador genera una clase
      `Program` INTERNA. WebApplicationFactory necesita verla para localizar el punto de
      entrada; abrirla al ensamblado de tests es preferible a hacerla pública, que
      convertiría un detalle del arranque en API del host.
    -->
    <InternalsVisibleTo Include="Bastion.Api.FunctionalTests" />
    <InternalsVisibleTo Include="Bastion.Organizacion.IntegrationTests" />
  </ItemGroup>

</Project>
