<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infraestructura del módulo Terceros: su DbContext propio con su esquema y su propio historial
    de migraciones (§14), las configuraciones de EF Core y los repositorios. Implementa los
    puertos que declara Application; la dependencia sigue apuntando hacia dentro.
  -->

  <ItemGroup>
    <ProjectReference Include="../Bastion.Terceros.Application/Bastion.Terceros.Application.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Infrastructure/Bastion.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Las migraciones de este módulo viven en `db/migraciones/Terceros` (§14): fuera del proyecto,
    para que todas las del sistema se lean juntas y en orden. Fuera del proyecto quiere decir que
    el glob por defecto del SDK NO las compila, y una migración que no está en el ensamblado no
    existe para EF: `Migrate()` aplicaría cero migraciones y crearía cero tablas, sin error y sin
    aviso. De ahí esta inclusión explícita.
  -->
  <ItemGroup Label="Migraciones">
    <Compile Include="../../../../db/migraciones/Terceros/**/*.cs" LinkBase="Migrations" />
  </ItemGroup>

  <!--
    Sin bloque de semillas, y no por olvido: Terceros no tiene maestros de instalación que
    sembrar. Un tercero lo da de alta una empresa; no viene con el producto.
  -->

  <ItemGroup Label="Persistencia">
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
